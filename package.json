{
  "name": "open-repository",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "View the active file and its repository on its Git host's website.",
  "keywords": [
    "github",
    "gitlab",
    "bitbucket",
    "blame",
    "browser",
    "vcs"
  ],
  "repository": "https://github.com/lumine-code/open-repository",
  "bugs": {
    "url": "https://github.com/lumine-code/open-repository/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can open the current file on its Git host's website with {{ 'open-repository:file' | keystroke }}",
    "You can read the blame of the current file on your Git host with {{ 'open-repository:blame' | keystroke }}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationCommands": {
    "lumine-workspace": [
      "open-repository:blame",
      "open-repository:branch-compare",
      "open-repository:copy-url",
      "open-repository:file",
      "open-repository:file-on-master",
      "open-repository:history",
      "open-repository:issues",
      "open-repository:pull-requests",
      "open-repository:repository"
    ]
  },
  "configSchema": {
    "includeLineNumbersInUrls": {
      "title": "Include Line Numbers In URLs",
      "description": "Include the line range selected in the editor when opening or copying URLs to the clipboard. When opened in the browser, the host's page will automatically scroll to the selected line range.",
      "type": "boolean",
      "default": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#ba2792e2fd5637748cdc9317886e6d3cac2ce801",
    "@lumine-code/temp": "github:lumine-code/node-temp#dea2a8044298b52fbeeb0aef257706dd6d671927",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
