{
  "name": "open-repository",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "View the active file and its repository on its Git host's website.",
  "keywords": [
    "github",
    "gitlab",
    "bitbucket",
    "blame",
    "browser",
    "vcs"
  ],
  "repository": "https://github.com/lumine-code/open-repository",
  "bugs": {
    "url": "https://github.com/lumine-code/open-repository/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "includeLineNumbersInUrls": {
      "title": "Include Line Numbers In URLs",
      "description": "Include the line range selected in the editor when opening or copying URLs to the clipboard. When opened in the browser, the host's page will automatically scroll to the selected line range.",
      "type": "boolean",
      "default": true
    }
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#a78a80911e995d4ed3e002c259d1b4a8f54c838b",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#4eaf72f977aa93184026532974e562d5072c7005",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
